<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>simple-cli</id>
    <version>__REPLACE__</version>
    <title>Simple CLI</title>
    <authors>Luke Krasnoff</authors>
    <packageSourceUrl>https://community.chocolatey.org/packages/simple-cli</packageSourceUrl>
    <projectUrl>https://github.com/lukekras/simplecli</projectUrl>
    <tags>cli golang simple</tags>
    <description>This simple CLI will give you the ability to output the GOOS, operating system, and GOARCH, architecture, for your go environment.</description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
